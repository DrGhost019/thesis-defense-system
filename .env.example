# Database Configuration
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/thesis_defense"

# JWT Authentication Secrets (Use strong random 32+ character strings)
JWT_SECRET="replace_with_a_strong_random_jwt_secret"
JWT_REFRESH_SECRET="replace_with_a_strong_random_refresh_secret"

# Bale Messenger Integration (Obtain bot token from @BotFather in Bale)
BALE_BOT_TOKEN="your_bale_bot_token_here"
BALE_WEBHOOK_SECRET="your_bale_webhook_secret_here"
NEXT_PUBLIC_BALE_BOT_USERNAME="your_bale_bot_username"
NEXT_PUBLIC_BALE_BOT_URL="https://ble.ir/your_bale_bot_username"
# Set to "true" only if you run `npm run bot:start` as a separate process
# BALE_DISABLE_EMBEDDED_BOT="false"

# Regional & Cron Settings
TIMEZONE="Asia/Tehran"
REMINDER_TIME="09:00"
LINK_CODE_TTL_MINUTES="10"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare Turnstile CAPTCHA (Obtain from https://dash.cloudflare.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_turnstile_site_key_here"
TURNSTILE_SECRET_KEY="your_turnstile_secret_key_here"
